# =========================================================
# Stash — Docker Compose Environment
# Copy to `.env` and set the database credentials (or keep defaults).
# API keys are configured in-app via the Settings console and stored
# in PostgreSQL — nothing goes in here.
# =========================================================

# --- PostgreSQL (compose-only; the app connects via DATABASE_URL) ---
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash

# --- App ---
PORT=3000