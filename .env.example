# =========================================================
# Stash — Environment Variables
# Copy to `.env` (Compose) or `.env.local` (source dev) and adjust.
# API keys for movies/anime/books are now managed in-app via the
# Settings console (stored in PostgreSQL). No keys needed here.
# =========================================================

# --- PostgreSQL (used by the app container) ---
# For source-dev, point DATABASE_URL at your local Postgres, e.g.:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/stash
DATABASE_URL=postgres://stash:stash@db:5432/stash

# --- Compose-only tuning (ignored by the app itself) ---
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash

# --- App ---
PORT=3000